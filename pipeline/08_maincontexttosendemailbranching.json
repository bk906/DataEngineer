{
	"name": "08_maincontexttosendemailbranching",
	"properties": {
		"description": "sending the mail if copydat is successfully executes then business users will receive the mail successfull if pipelines fails developers will receive the mail",
		"activities": [
			{
				"name": "Execute copydata_01",
				"type": "ExecutePipeline",
				"dependsOn": [],
				"policy": {
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"pipeline": {
						"referenceName": "01_copyData",
						"type": "PipelineReference"
					},
					"waitOnCompletion": true
				}
			},
			{
				"name": "BusinessUsers",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Execute copydata_01",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-15.westus2.logic.azure.com:443/workflows/2d16785b4f674638a682357fe98b5ab7/triggers/When_a_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_a_HTTP_request_is_received%2Frun&sv=1.0&sig=GGpxf8AAIGNGDKS-FKGHBJmDLolsxTXa8Pao5W_vXrs",
					"body": {
						"Message": "Current pipeline is success",
						"DataFactoryName": "@{pipeline().DataFactory}",
						"pipelineName": "@{pipeline().Pipeline}",
						"EmailTo": "bhavanireddyk26@gmail.com",
						"Subject": "pipeline Success"
					}
				}
			},
			{
				"name": "Developers",
				"type": "WebActivity",
				"dependsOn": [
					{
						"activity": "Execute copydata_01",
						"dependencyConditions": [
							"Failed"
						]
					}
				],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"method": "POST",
					"url": "https://prod-15.westus2.logic.azure.com:443/workflows/2d16785b4f674638a682357fe98b5ab7/triggers/When_a_HTTP_request_is_received/paths/invoke?api-version=2016-10-01&sp=%2Ftriggers%2FWhen_a_HTTP_request_is_received%2Frun&sv=1.0&sig=GGpxf8AAIGNGDKS-FKGHBJmDLolsxTXa8Pao5W_vXrs",
					"body": {
						"value": "{\n  \"Message\": \"Current pipeline is Failed\",\n  \"DataFactoryName\": \"@{pipeline().DataFactory}\",\n  \"pipelineName\": \"@{pipeline().Pipeline}\",\n  \"EmailTo\": \"vcbr626@gmail.com\",\n  \"Subject\": \"pipeline Failed\"\n}",
						"type": "Expression"
					}
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2025-09-02T15:18:44Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
