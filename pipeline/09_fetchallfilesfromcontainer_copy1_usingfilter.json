{
	"name": "09_fetchallfilesfromcontainer_copy1_usingfilter",
	"properties": {
		"description": "copyallfilesfrom containerin datalakesa and loading dynamically all files in to the table using getmetadataandfetchactivitys and parameterized",
		"activities": [
			{
				"name": "Get Metadata1fromcontainer",
				"type": "GetMetadata",
				"dependsOn": [],
				"policy": {
					"timeout": "0.12:00:00",
					"retry": 0,
					"retryIntervalInSeconds": 30,
					"secureOutput": false,
					"secureInput": false
				},
				"userProperties": [],
				"typeProperties": {
					"dataset": {
						"referenceName": "FetchcsvDelimitedText2",
						"type": "DatasetReference"
					},
					"fieldList": [
						"childItems"
					],
					"storeSettings": {
						"type": "AzureBlobFSReadSettings",
						"recursive": true,
						"enablePartitionDiscovery": false
					},
					"formatSettings": {
						"type": "DelimitedTextReadSettings"
					}
				}
			},
			{
				"name": "Filter1",
				"type": "Filter",
				"dependsOn": [
					{
						"activity": "Get Metadata1fromcontainer",
						"dependencyConditions": [
							"Succeeded"
						]
					}
				],
				"userProperties": [],
				"typeProperties": {
					"items": {
						"value": "@activity('Get Metadata1fromcontainer').output.childItems",
						"type": "Expression"
					},
					"condition": {
						"value": "@or(endswith(item().name,'.csv'),endswith(item().name, '.xlsx' ))",
						"type": "Expression"
					}
				}
			}
		],
		"annotations": [],
		"lastPublishTime": "2025-09-03T03:57:22Z"
	},
	"type": "Microsoft.DataFactory/factories/pipelines"
}